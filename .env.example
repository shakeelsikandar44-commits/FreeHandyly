# Copy to .env for local development (never commit .env). On a host, set these as environment variables instead.

# Public address of the site, no trailing slash. Used for canonical URLs, sitemap.xml and robots.txt.
SITE_URL=https://freehandyly.com

# Any long random string (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=change-me

# 1 when running behind a proxy/load balancer (Render, Railway, Fly, Nginx) so https and client IPs are detected.
TRUST_PROXY=1
# 1 to redirect http:// requests to https:// (leave unset if your host already does this).
FORCE_HTTPS=

# Contact form e-mail delivery (optional). Without SMTP_HOST, messages are only appended to instance/messages.jsonl.
CONTACT_TO=contact@freehandyly.com
# Recommended on Render free (SMTP is blocked there): Brevo API key. CONTACT_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
CONTACT_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional: fixed lastmod date (YYYY-MM-DD) for sitemap.xml. Default: date of the newest page file.
SITEMAP_LASTMOD=
